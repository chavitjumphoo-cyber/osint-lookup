# Set a real key here, or save it through the application's API settings.
ANTHROPIC_API_KEY=

# Optional Anthropic-compatible provider. Leave commented for Anthropic directly.
# ANTHROPIC_BASE_URL=https://your-provider.example

# MaxPlus GPT (use the model ID returned by your key's /v1/models endpoint):
# OSINT_PROVIDER=openai
# ANTHROPIC_BASE_URL=https://api.maxplus-ai.cc/v1
# OSINT_MODEL=your-model-id

# MaxPlus Claude uses OSINT_PROVIDER=anthropic,
# ANTHROPIC_BASE_URL=https://api.maxplus-ai.cc and a supported Claude model ID.

# Optional key for the existing breach_check tool.
# HIBP_API_KEY=
